              },
              {
                "name": "caption",
                "value": "={{ $('Webhook').item.json.body.content + '\\n\\n' + ($('Webhook').item.json.body.hashtags || '') }}"
              },
              {
                "name": "access_token",
                "value": "={{ $env.INSTAGRAM_ACCESS_TOKEN }}"
              }
            ]
          },
          "options": {}
