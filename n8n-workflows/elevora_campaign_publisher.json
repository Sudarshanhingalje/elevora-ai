[
  {
    "name": "Elevora Campaign Publisher",
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "elevora-campaign-publisher",
          "responseMode": "onReceived",
          "options": {}
        },
        "id": "webhook-trigger",
        "name": "Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 1,
        "position": [
          240,
          320
        ]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify({ received: true, postId: $json.body.postId }) }}",
          "options": {}
        },
        "id": "webhook-respond",
        "name": "Respond 200 OK",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1,
        "position": [
          460,
          200
        ]
      },
      {
        "parameters": {
          "conditions": {
            "string": [
              {
                "value1": "={{ $json.body.imagePrompt }}",
                "operation": "isNotEmpty"
              }
            ]
          }
        },
        "id": "if-image-prompt",
        "name": "Has Image Prompt?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 1,
        "position": [
          460,
          420
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ $env.COMFYUI_BASE_URL }}/prompt",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "sendBody": true,
          "bodyParameters": {
            "parameters": [
              {
                "name": "prompt",
                "value": "={{ JSON.stringify({ \"3\": { \"inputs\": { \"seed\": Math.floor(Math.random()*999999), \"steps\": 20, \"cfg\": 7, \"sampler_name\": \"euler\", \"scheduler\": \"normal\", \"denoise\": 1, \"model\": [\"4\",0], \"positive\": [\"6\",0], \"negative\": [\"7\",0], \"latent_image\": [\"5\",0] }, \"class_type\": \"KSampler\" }, \"4\": { \"inputs\": { \"ckpt_name\": \"v1-5-pruned-emaonly.ckpt\" }, \"class_type\": \"CheckpointLoaderSimple\" }, \"5\": { \"inputs\": { \"width\": 1080, \"height\": 1080, \"batch_size\": 1 }, \"class_type\": \"EmptyLatentImage\" }, \"6\": { \"inputs\": { \"text\": $('Webhook').item.json.body.imagePrompt + \", marketing poster, professional, high quality, 4k\", \"clip\": [\"4\",1] }, \"class_type\": \"CLIPTextEncode\" }, \"7\": { \"inputs\": { \"text\": \"blurry, low quality, text, watermark\", \"clip\": [\"4\",1] }, \"class_type\": \"CLIPTextEncode\" }, \"8\": { \"inputs\": { \"samples\": [\"3\",0], \"vae\": [\"4\",2] }, \"class_type\": \"VAEDecode\" }, \"9\": { \"inputs\": { \"filename_prefix\": \"elevora_\" + $('Webhook').item.json.body.postId, \"images\": [\"8\",0] }, \"class_type\": \"SaveImage\" } }) }}"
              }
            ]
          },
          "options": {}
        },
        "id": "comfyui-queue",
        "name": "ComfyUI — Queue Prompt",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [
          680,
          340
        ]
      },
      {
        "parameters": {
          "amount": 35,
          "unit": "seconds"
        },
        "id": "wait-comfyui",
        "name": "Wait 35s for Generation",
        "type": "n8n-nodes-base.wait",
        "typeVersion": 1,
        "position": [
          900,
          340
        ]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{ $env.COMFYUI_BASE_URL }}/history/{{ $('ComfyUI — Queue Prompt').item.json.prompt_id }}",
          "options": {}
        },
        "id": "comfyui-history",
        "name": "ComfyUI — Get History",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [
          1120,
          340
        ]
      },
      {
        "parameters": {
          "method": "GET",
          "url": "={{ $env.COMFYUI_BASE_URL }}/view?filename={{ Object.values(Object.values($json)[0].outputs)[0].images[0].filename }}&subfolder=&type=output",
          "options": {
            "response": {
              "response": {
                "responseFormat": "file"
              }
            }
          }
        },
        "id": "comfyui-download",
        "name": "ComfyUI — Download Image",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [
          1340,
          340
        ]
      },
      {
        "parameters": {
          "method": "PUT",
          "url": "={{ $env.MINIO_ENDPOINT }}/{{ $env.MINIO_BUCKET }}/campaign-images/{{ Object.values(Object.values($('ComfyUI — Get History').item.json)[0].outputs)[0].images[0].filename }}",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "Content-Type",
                "value": "image/png"
              },
              {
                "name": "x-amz-acl",
                "value": "public-read"
              }
            ]
          },
          "sendBody": true,
          "contentType": "binaryData",
          "inputDataFieldName": "data",
          "options": {
            "allowUnauthorizedCerts": true,
            "batching": {
              "batch": {
                "batchSize": 1,
                "batchInterval": 0
              }
            }
          }
        },
        "id": "minio-upload",
        "name": "MinIO — Upload Image",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4,
        "position": [
          1580,
          340
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "minio-auth",
            "name": "MinIO Auth"
          }
        }
      },
      {
        "parameters": {
          "conditions": {
            "string": [
              {
                "value1": "={{ $('Webhook').item.json.body.platforms }}",
                "operation": "contains",
                "value2": "Instagram"
              },
              {
                "value1": "={{ $('Webhook').item.json.body.imagePrompt }}",
                "operation": "isNotEmpty"
              }
            ]
          }
        },
        "id": "if-instagram",
        "name": "Post to Instagram?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 1,
        "position": [
