# Elevora AI environment template
# Copy this file to .env for local development.
# Never commit a real .env file to GitHub.
# SAFE values may be committed. SECRET values below are placeholders only.

# -----------------------------------------------------------------------------
# Application - SAFE
# -----------------------------------------------------------------------------
APP_ENV=development
APP_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
TZ=Asia/Kolkata

# -----------------------------------------------------------------------------
# MySQL 8
# -----------------------------------------------------------------------------
# SAFE - Master Guide 8.2
DB_HOST=localhost
# SAFE - confirmed local port, changed from 3306 because of port conflict
MYSQL_PORT=3307
# SAFE
DB_PORT=3307
# SAFE - confirmed
DB_NAME=elevora_ai
# SAFE - confirmed
DB_USERNAME=elevora_app
# SECRET - Master Guide 8.2, never commit the real value
DB_PASSWORD=replace_with_strong_database_password
# SECRET - never commit the real value
DB_ROOT_PASSWORD=replace_with_strong_mysql_root_password

# -----------------------------------------------------------------------------
# JWT / Auth
# -----------------------------------------------------------------------------
# SECRET - Master Guide 8.2, use a 64+ character random value
JWT_SECRET=7f8c9a2b4d6e8f1a3c5d7e9f2a4b6c8d1e3f5a7b9c2d4e6f8a1b3c5d7e9f1a2
# SAFE - Master Guide 8.2, 900 seconds = 15 minutes
JWT_EXPIRY=900
# SAFE - 604800 seconds = 7 days
JWT_REFRESH_EXPIRY=604800
# SAFE - JWT must stay in HTTP-only cookies, never localStorage
JWT_COOKIE_NAME=elevora_access_token
JWT_REFRESH_COOKIE_NAME=elevora_refresh_token
JWT_COOKIE_HTTP_ONLY=true
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Strict
# SAFE - bcrypt cost factor required by Master Guide
BCRYPT_COST=12
# SAFE
OTP_EXPIRY_SECONDS=300
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_LOCK_MINUTES=15
# SAFE - creates/updates the platform owner only when OWNER_PASSWORD is present
OWNER_EMAIL=elevoraai.team@gmail.com
OWNER_TENANT_SLUG=elevora-ai
OWNER_TENANT_NAME=Elevora AI
# SECRET - bcrypt hashed by backend at startup, never stored as plain text
OWNER_PASSWORD=replace_with_owner_admin_password

# -----------------------------------------------------------------------------
# Redis 7 - rate limiting, OTP, cache
# -----------------------------------------------------------------------------
# SAFE
REDIS_HOST=localhost
REDIS_PORT=6379
# SECRET - Master Guide 8.2, never commit the real value
REDIS_PASSWORD=replace_with_strong_redis_password
# SAFE - Master Guide security rule
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# -----------------------------------------------------------------------------
# Razorpay - Week 2 placeholders
# -----------------------------------------------------------------------------
# SECRET - Master Guide 8.2, never commit the real value
RAZORPAY_KEY_ID=replace_with_razorpay_key_id
# SECRET - alias used by some Razorpay snippets, keep same as RAZORPAY_KEY_ID
RAZORPAY_KEY=replace_with_razorpay_key_id
# SECRET - Master Guide 8.2, never commit the real value
RAZORPAY_SECRET=replace_with_razorpay_secret
# SECRET - never commit the real value
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# -----------------------------------------------------------------------------
# MinIO object storage
# -----------------------------------------------------------------------------
# SECRET - Master Guide 8.2, never commit the real value
MINIO_ACCESS_KEY=replace_with_minio_access_key
# SECRET - used by docker-compose, never commit the real value
MINIO_ROOT_USER=replace_with_minio_root_user
# SECRET - used by docker-compose, never commit the real value
MINIO_ROOT_PASSWORD=replace_with_strong_minio_root_password
# SAFE
MINIO_ENDPOINT=http://localhost:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=elevora-assets

# -----------------------------------------------------------------------------
# Ollama local AI runtime
# -----------------------------------------------------------------------------
# SAFE - Master Guide 8.2
OLLAMA_HOST=http://localhost:11434
# SAFE
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=24h
OLLAMA_CHAT_MODEL=llama3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# Qdrant vector database
# -----------------------------------------------------------------------------
# SAFE
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=elevora_knowledge
# SECRET - never commit the real value
QDRANT_API_KEY=Sudu@1308

# -----------------------------------------------------------------------------
# CORS / trusted origins
# -----------------------------------------------------------------------------
# SAFE - Master Guide 8.2
CORS_ALLOWED_ORIGIN=https://elevora.ai
# SAFE - security rule allows only elevora.ai and localhost:3000
CORS_ALLOWED_ORIGINS=https://elevora.ai,http://localhost:3000

# -----------------------------------------------------------------------------
# n8n automation
# -----------------------------------------------------------------------------
# SAFE
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASE_URL=http://localhost:5678
N8N_BASIC_AUTH_USER=admin
# SECRET - never commit the real value
N8N_BASIC_AUTH_PASSWORD=replace_with_strong_n8n_password
# SECRET - never commit the real value
N8N_ENCRYPTION_KEY=replace_with_32_plus_character_n8n_key

# -----------------------------------------------------------------------------
# Week 7 WhatsApp Business automation
# -----------------------------------------------------------------------------
# SAFE
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v20.0
# SECRET - Meta WhatsApp Business phone number id
WHATSAPP_BUSINESS_PHONE_NUMBER_ID=
# SECRET - Meta WhatsApp Cloud API token
WHATSAPP_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Nginx reverse proxy
# -----------------------------------------------------------------------------
# SAFE
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
PUBLIC_DOMAIN=elevora.ai

# -----------------------------------------------------------------------------
# Monitoring - Prometheus and Grafana
# -----------------------------------------------------------------------------
# SAFE
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3001
GRAFANA_ROOT_URL=http://localhost:3001
GRAFANA_ADMIN_USER=admin
# SECRET - never commit the real value
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password

# -----------------------------------------------------------------------------
# Email / OTP delivery
# -----------------------------------------------------------------------------
# SAFE
MAIL_HOST=localhost
MAIL_PORT=1026
MAIL_SMTP_PORT=1026
MAIL_WEB_PORT=8026
MAIL_FROM=no-reply@elevora.ai
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
# SECRET - never commit the real value
MAIL_USERNAME=
# SECRET - never commit the real value
MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# OAuth login - Google
# -----------------------------------------------------------------------------
# SAFE
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback
# SECRET - from Google Cloud OAuth client
GOOGLE_OAUTH_CLIENT_ID=
# SECRET - from Google Cloud OAuth client
GOOGLE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Week 9 / Week 10 AI agents
# -----------------------------------------------------------------------------
# SAFE - ComfyUI local open-source image generation endpoint
STABLE_DIFFUSION_BASE_URL=http://127.0.0.1:8188
# SAFE - exported ComfyUI workflow JSON file path; include {{PROMPT}} where the agent prompt should be inserted
COMFYUI_WORKFLOW_PATH=
# SAFE
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
# SECRET - Instagram Graph API business account id
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# SECRET - Instagram Graph API access token
INSTAGRAM_ACCESS_TOKEN=
# SAFE - WordPress site base URL
WORDPRESS_BASE_URL=
# SECRET - WordPress publishing username
WORDPRESS_USERNAME=
# SECRET - WordPress application password
WORDPRESS_APPLICATION_PASSWORD=

# -----------------------------------------------------------------------------
# Security headers / cookies
# -----------------------------------------------------------------------------
# SAFE - set true in production HTTPS
SECURE_COOKIES=false
# SAFE - set true in production HTTPS
HSTS_ENABLED=false
# SAFE
CSRF_ENABLED=true
